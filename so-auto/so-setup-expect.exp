#!/usr/bin/expect -f

################################################################################
# Security Onion Expect Automation Script
# Automates the so-setup interactive installer
# Called by install_so.sh with environment variables set
################################################################################

# Enable logging to see what's happening
log_user 1
exp_internal 0

# Increase timeout for long operations
set timeout 600

# Force proper terminal settings
set stty_init "raw -echo"

# Get environment variables from bash wrapper
set NODE_TYPE $env(NODE_TYPE)
set HOSTNAME $env(HOSTNAME)
set STATIC_IP $env(STATIC_IP)
set GATEWAY $env(GATEWAY)
set DNS_SERVER $env(DNS_SERVER)
set DNS_SEARCH_DOMAIN $env(DNS_SEARCH_DOMAIN)
set ADMIN_EMAIL $env(ADMIN_EMAIL)
set ADMIN_PASSWORD $env(ADMIN_PASSWORD)
set ANALYST_IP_RANGE $env(ANALYST_IP_RANGE)

# Manager IP and hostname for search/sensor nodes
if {[info exists env(MANAGER_IP)]} {
    set MANAGER_IP $env(MANAGER_IP)
} else {
    set MANAGER_IP ""
}

if {[info exists env(MANAGER_HOSTNAME)]} {
    set MANAGER_HOSTNAME $env(MANAGER_HOSTNAME)
} else {
    set MANAGER_HOSTNAME ""
}

# Debug output
puts "========================================"
puts "Security Onion Automated Setup"
puts "========================================"
puts "Node Type: $NODE_TYPE"
puts "Hostname: $HOSTNAME"
puts "Static IP: $STATIC_IP"
puts "Gateway: $GATEWAY"
puts "DNS: $DNS_SERVER"
puts "DNS Search Domain: $DNS_SEARCH_DOMAIN"
puts "Analyst IP Range: $ANALYST_IP_RANGE"
puts "========================================"

# Arrow key sequences
set DOWN "\033\[B"
set UP "\033\[A"
set TAB "\t"

# Start so-setup with iso parameter
spawn sudo /home/tester/SecurityOnion/setup/so-setup iso

################################################################################
# Helper procedures
################################################################################

# Clear an input field and enter new value
proc clear_and_type {value} {
    # Ctrl+U to clear the line, then type the value
    send "\025"
    sleep 2
    send "$value"
}

################################################################################
# MANAGER Installation Flow
################################################################################

if {$NODE_TYPE eq "manager"} {
    # STEP 1: Welcome - Wait for dialog to appear, then Enter for Yes
    puts "\n>>> Waiting for installer to load..."
    expect {
        -re "Yes|No|Continue|Welcome" {
            puts "\n>>> Step 1: Welcome dialog detected - pressing Enter for Yes"
            sleep 1
            send "\r"
        }
        timeout {
            puts "\n>>> Timeout waiting for welcome screen"
            exit 1
        }
    }

    # STEP 2: Install type - Enter for Install (first option)
    sleep 2
    puts "\n>>> Step 2: Install type - pressing Enter for Install"
    send "\r"

    # STEP 3: Deployment - Down, Down, Down, Enter for Distributed
    sleep 2
    puts "\n>>> Step 3: Deployment - selecting Distributed (3x Down, Enter)"
    send "$DOWN"
    sleep 2
    send "$DOWN"
    sleep 2
    send "$DOWN"
    sleep 2
    send "\r"

    # STEP 4: New deployment - Enter (already selected)
    sleep 2
    puts "\n>>> Step 4: New deployment - pressing Enter"
    send "\r"

    # STEP 5: Role - Enter for Manager (already selected)
    sleep 2
    puts "\n>>> Step 5: Role - pressing Enter for Manager"
    send "\r"

    # STEP 6: License - Type AGREE
    sleep 2
    puts "\n>>> Step 6: License - typing AGREE"
    send "AGREE\r"

    # STEP 7: Network type - Down, Enter for Airgap
    sleep 2
    puts "\n>>> Step 7: Network type - selecting Airgap (Down, Enter)"
    send "$DOWN"
    sleep 2
    send "\r"

    # STEP 8: Hostname - Enter hostname from config
    sleep 2
    puts "\n>>> Step 8: Hostname - entering $HOSTNAME"
    clear_and_type $HOSTNAME
    send "\r"

    # STEP 9: Description - Leave blank, just Enter
    sleep 2
    puts "\n>>> Step 9: Description - leaving blank"
    send "\r"

    # STEP 10: NIC selection - Enter for first/default
    sleep 2
    puts "\n>>> Step 10: NIC - pressing Enter for default"
    send "\r"

    # STEP 11: IP assignment - Enter for Static
    sleep 2
    puts "\n>>> Step 11: IP assignment - pressing Enter for Static"
    send "\r"

    # STEP 12: IP Address/CIDR
    sleep 2
    puts "\n>>> Step 12: IP Address - entering $STATIC_IP/24"
    clear_and_type "$STATIC_IP/24"
    send "\r"

    # STEP 13: Gateway
    sleep 2
    puts "\n>>> Step 13: Gateway - entering $GATEWAY"
    clear_and_type $GATEWAY
    send "\r"

    # STEP 14: DNS - Delete defaults (8.8.8.8, 8.8.4.4), add new
    sleep 2
    puts "\n>>> Step 14: DNS - removing defaults, adding $DNS_SERVER"
    # Delete first default (d), delete second default (d), add new (a)
    send "d"
    sleep 2
    send "d"
    sleep 2
    send "a"
    sleep 2
    send "$DNS_SERVER\r"
    sleep 2
    send "\r"

    # STEP 15: DNS Search Domain - Delete default, enter new
    sleep 2
    puts "\n>>> Step 15: DNS Search Domain - entering $DNS_SEARCH_DOMAIN"
    clear_and_type $DNS_SEARCH_DOMAIN
    send "\r"

    # STEP 16: Docker defaults - Enter for Yes
    sleep 2
    puts "\n>>> Step 16: Docker defaults - pressing Enter for Yes"
    send "\r"

    # STEP 17: Username/Email
    sleep 2
    puts "\n>>> Step 17: Username/Email - entering $ADMIN_EMAIL"
    clear_and_type $ADMIN_EMAIL
    send "\r"

    # STEP 18: Password (only once)
    sleep 2
    puts "\n>>> Step 18: Password - entering password"
    send "$ADMIN_PASSWORD\r"

    # STEP 19: Web interface access - Enter for IP
    sleep 2
    puts "\n>>> Step 19: Web access method - pressing Enter for IP"
    send "\r"

    # STEP 20: Access to web - Enter for Yes
    sleep 2
    puts "\n>>> Step 20: Web access confirmation - pressing Enter"
    send "\r"

    # STEP 21: Analyst IP range (with .0 as last octet)
    sleep 2
    puts "\n>>> Step 21: Analyst IP range - entering $ANALYST_IP_RANGE"
    clear_and_type $ANALYST_IP_RANGE
    send "\r"

    # STEP 22: Final confirmation - Tab, Enter
    sleep 2
    puts "\n>>> Step 22: Final confirmation - Tab, Enter"
    send "$TAB"
    sleep 2
    send "\r"

    puts "\n>>> Manager setup commands sent - waiting for installation..."
}

################################################################################
# SEARCH NODE Installation Flow
################################################################################

if {$NODE_TYPE eq "search"} {
    # STEP 1: Welcome - Wait for dialog to appear, then Enter for Yes
    puts "\n>>> Waiting for installer to load..."
    expect {
        -re "Yes|No|Continue|Welcome" {
            puts "\n>>> Step 1: Welcome dialog detected - pressing Enter for Yes"
            sleep 1
            send "\r"
        }
        timeout {
            puts "\n>>> Timeout waiting for welcome screen"
            exit 1
        }
    }

    # STEP 2: Install type - Enter for Install
    sleep 2
    puts "\n>>> Step 2: Install type - pressing Enter for Install"
    send "\r"

    # STEP 3: Deployment - Down, Down, Down, Enter for Distributed
    sleep 2
    puts "\n>>> Step 3: Deployment - selecting Distributed (3x Down, Enter)"
    send "$DOWN"
    sleep 2
    send "$DOWN"
    sleep 2
    send "$DOWN"
    sleep 2
    send "\r"

    # STEP 4: Existing deployment - Down, Enter
    sleep 2
    puts "\n>>> Step 4: Existing deployment - Down, Enter"
    send "$DOWN"
    sleep 2
    send "\r"

    # STEP 5: Role - Down for SEARCHNODE, Enter
    sleep 2
    puts "\n>>> Step 5: Role - selecting SEARCHNODE (Down, Enter)"
    send "$DOWN"
    sleep 2
    send "\r"

    # STEP 6: License - Type AGREE
    sleep 2
    puts "\n>>> Step 6: License - typing AGREE"
    send "AGREE\r"

    # STEP 7: Network type - Down, Enter for Airgap
    sleep 2
    puts "\n>>> Step 7: Network type - selecting Airgap (Down, Enter)"
    send "$DOWN"
    sleep 2
    send "\r"

    # STEP 8: Hostname
    sleep 2
    puts "\n>>> Step 8: Hostname - entering $HOSTNAME"
    clear_and_type $HOSTNAME
    send "\r"

    # STEP 9: Description - Leave blank
    sleep 2
    puts "\n>>> Step 9: Description - leaving blank"
    send "\r"

    # STEP 10: NIC selection - Enter
    sleep 2
    puts "\n>>> Step 10: NIC - pressing Enter"
    send "\r"

    # STEP 11: IP assignment - Enter for Static
    sleep 2
    puts "\n>>> Step 11: IP assignment - pressing Enter for Static"
    send "\r"

    # STEP 12: IP Address/CIDR
    sleep 2
    puts "\n>>> Step 12: IP Address - entering $STATIC_IP/24"
    clear_and_type "$STATIC_IP/24"
    send "\r"

    # STEP 13: Gateway
    sleep 2
    puts "\n>>> Step 13: Gateway - entering $GATEWAY"
    clear_and_type $GATEWAY
    send "\r"

    # STEP 14: DNS
    sleep 2
    puts "\n>>> Step 14: DNS - removing defaults, adding $DNS_SERVER"
    send "d"
    sleep 2
    send "d"
    sleep 2
    send "a"
    sleep 2
    send "$DNS_SERVER\r"
    sleep 2
    send "\r"

    # STEP 15: DNS Search Domain
    sleep 2
    puts "\n>>> Step 15: DNS Search Domain - entering $DNS_SEARCH_DOMAIN"
    clear_and_type $DNS_SEARCH_DOMAIN
    send "\r"

    # STEP 16: Manager hostname
    sleep 2
    puts "\n>>> Step 16: Manager hostname - entering $MANAGER_HOSTNAME"
    clear_and_type $MANAGER_HOSTNAME
    send "\r"

    # STEP 17: Manager IP (if prompted)
    sleep 2
    puts "\n>>> Step 17: Manager IP - entering $MANAGER_IP"
    clear_and_type $MANAGER_IP
    send "\r"

    # STEP 18: Docker defaults - Enter for Yes
    sleep 2
    puts "\n>>> Step 18: Docker defaults - pressing Enter for Yes"
    send "\r"

    # STEP 19: Web interface access - Enter for IP
    sleep 2
    puts "\n>>> Step 19: Web access method - pressing Enter for IP"
    send "\r"

    # STEP 20: Access confirmation - Enter
    sleep 2
    puts "\n>>> Step 20: Web access confirmation - pressing Enter"
    send "\r"

    # STEP 21: Analyst IP range
    sleep 2
    puts "\n>>> Step 21: Analyst IP range - entering $ANALYST_IP_RANGE"
    clear_and_type $ANALYST_IP_RANGE
    send "\r"

    # STEP 22: Final confirmation - Tab, Enter
    sleep 2
    puts "\n>>> Step 22: Final confirmation - Tab, Enter"
    send "$TAB"
    sleep 2
    send "\r"

    puts "\n>>> Search node setup commands sent - waiting for installation..."
}

################################################################################
# SENSOR Installation Flow
################################################################################

if {$NODE_TYPE eq "sensor"} {
    # STEP 1: Welcome - Wait for dialog to appear, then Enter for Yes
    puts "\n>>> Waiting for installer to load..."
    expect {
        -re "Yes|No|Continue|Welcome" {
            puts "\n>>> Step 1: Welcome dialog detected - pressing Enter for Yes"
            sleep 1
            send "\r"
        }
        timeout {
            puts "\n>>> Timeout waiting for welcome screen"
            exit 1
        }
    }

    # STEP 2: Install type - Enter for Install
    sleep 2
    puts "\n>>> Step 2: Install type - pressing Enter for Install"
    send "\r"

    # STEP 3: Deployment - Down, Down, Down, Enter for Distributed
    sleep 2
    puts "\n>>> Step 3: Deployment - selecting Distributed (3x Down, Enter)"
    send "$DOWN"
    sleep 2
    send "$DOWN"
    sleep 2
    send "$DOWN"
    sleep 2
    send "\r"

    # STEP 4: Existing deployment - Down, Enter
    sleep 2
    puts "\n>>> Step 4: Existing deployment - Down, Enter"
    send "$DOWN"
    sleep 2
    send "\r"

    # STEP 5: Role - Down, Down for SENSOR, Enter
    sleep 2
    puts "\n>>> Step 5: Role - selecting SENSOR (Down, Down, Enter)"
    send "$DOWN"
    sleep 2
    send "$DOWN"
    sleep 2
    send "\r"

    # STEP 6: License - Type AGREE
    sleep 2
    puts "\n>>> Step 6: License - typing AGREE"
    send "AGREE\r"

    # STEP 7: Network type - Down, Enter for Airgap
    sleep 2
    puts "\n>>> Step 7: Network type - selecting Airgap (Down, Enter)"
    send "$DOWN"
    sleep 2
    send "\r"

    # STEP 8: Hostname
    sleep 2
    puts "\n>>> Step 8: Hostname - entering $HOSTNAME"
    clear_and_type $HOSTNAME
    send "\r"

    # STEP 9: Description - Leave blank
    sleep 2
    puts "\n>>> Step 9: Description - leaving blank"
    send "\r"

    # STEP 10: Management NIC - Enter
    sleep 2
    puts "\n>>> Step 10: Management NIC - pressing Enter"
    send "\r"

    # STEP 11: IP assignment - Enter for Static
    sleep 2
    puts "\n>>> Step 11: IP assignment - pressing Enter for Static"
    send "\r"

    # STEP 12: IP Address/CIDR
    sleep 2
    puts "\n>>> Step 12: IP Address - entering $STATIC_IP/24"
    clear_and_type "$STATIC_IP/24"
    send "\r"

    # STEP 13: Gateway
    sleep 2
    puts "\n>>> Step 13: Gateway - entering $GATEWAY"
    clear_and_type $GATEWAY
    send "\r"

    # STEP 14: DNS
    sleep 2
    puts "\n>>> Step 14: DNS - removing defaults, adding $DNS_SERVER"
    send "d"
    sleep 2
    send "d"
    sleep 2
    send "a"
    sleep 2
    send "$DNS_SERVER\r"
    sleep 2
    send "\r"

    # STEP 15: DNS Search Domain
    sleep 2
    puts "\n>>> Step 15: DNS Search Domain - entering $DNS_SEARCH_DOMAIN"
    clear_and_type $DNS_SEARCH_DOMAIN
    send "\r"

    # STEP 16: Monitor interface - Enter (or manual selection needed)
    sleep 2
    puts "\n>>> Step 16: Monitor interface - pressing Enter"
    send "\r"

    # STEP 17: Manager hostname
    sleep 2
    puts "\n>>> Step 17: Manager hostname - entering $MANAGER_HOSTNAME"
    clear_and_type $MANAGER_HOSTNAME
    send "\r"

    # STEP 18: Manager IP
    sleep 2
    puts "\n>>> Step 18: Manager IP - entering $MANAGER_IP"
    clear_and_type $MANAGER_IP
    send "\r"

    # STEP 19: Docker defaults - Enter for Yes
    sleep 2
    puts "\n>>> Step 19: Docker defaults - pressing Enter for Yes"
    send "\r"

    # STEP 20: Web interface access - Enter for IP
    sleep 2
    puts "\n>>> Step 20: Web access method - pressing Enter for IP"
    send "\r"

    # STEP 21: Access confirmation - Enter
    sleep 2
    puts "\n>>> Step 21: Web access confirmation - pressing Enter"
    send "\r"

    # STEP 22: Analyst IP range
    sleep 2
    puts "\n>>> Step 22: Analyst IP range - entering $ANALYST_IP_RANGE"
    clear_and_type $ANALYST_IP_RANGE
    send "\r"

    # STEP 23: Final confirmation - Tab, Enter
    sleep 2
    puts "\n>>> Step 23: Final confirmation - Tab, Enter"
    send "$TAB"
    sleep 2
    send "\r"

    puts "\n>>> Sensor setup commands sent - waiting for installation..."
}

################################################################################
# Wait for completion
################################################################################

# Set longer timeout for installation (1 hour)
set timeout 3600

puts "\n>>> Waiting for installation to complete (this may take ~1 hour)..."

expect {
    -re "complete|finished|successfully|Complete|Finished|Successfully" {
        puts "\n>>> Installation complete dialog detected"
        sleep 2
        # Final confirmation - Tab, Enter
        puts "\n>>> Sending final Tab, Enter"
        send "$TAB"
        sleep 1
        send "\r"
        puts "\n========================================"
        puts "Installation completed successfully!"
        puts "========================================"
    }
    -re "error|failed|Error|Failed" {
        puts "\n========================================"
        puts "ERROR detected during installation"
        puts "========================================"
    }
    eof {
        puts "\n========================================"
        puts "Security Onion setup process ended"
        puts "========================================"
    }
    timeout {
        puts "\n========================================"
        puts "Setup still running (timeout reached)"
        puts "Check 'sudo so-status' for status"
        puts "========================================"
    }
}

# Hand control back to user for debugging
puts "\n>>> Handing control to user - you can now interact with the installer"
interact
