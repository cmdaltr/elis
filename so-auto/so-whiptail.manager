#!/bin/bash
# Copyright Security Onion Solutions LLC
# Licensed under the Elastic License 2.0

###############################################################################
# NOTE
# This file has been CLEANED so that ALL interactive whiptail entry points
# used by so-setup are overridden below.
#
# Result:
#   - No whiptail menus
#   - No prompts
#   - Deterministic Manager install
###############################################################################

###############################################################################
# HARD-CODED MANAGER ANSWERS (no prompts)
###############################################################################

# ---- fixed values ----
export HARD_HOSTNAME="so-manager"
export HARD_DESCRIPTION=""

export HARD_MGMT_CIDR="10.10.20.50/24"
export HARD_GATEWAY="10.10.20.254"
export HARD_DNS_SERVERS="10.10.20.253"
export HARD_SEARCH_DOMAIN="corp.example.com"

export HARD_WEBUSER="admin@example.com"
export HARD_WEBPASS="SuperSecretPassword"
export HARD_WEB_CIDR="10.10.20.0/24"
# ----------------------

###############################################################################
# Top-level flow (NO UI)
###############################################################################

whiptail_you_sure() { return 0; }

whiptail_first_menu_iso() {
  option="INSTALL"
  return 0
}

whiptail_install_type() {
  install_type="DISTRIBUTED"
  is_manager=true
  export install_type
  return 0
}

whiptail_install_type_dist() {
  dist_option="NEWDEPLOYMENT"
  return 0
}

whiptail_install_type_dist_new() {
  install_type="MANAGER"
  is_manager=true
  export install_type
  return 0
}

###############################################################################
# License / airgap
###############################################################################

whiptail_license() {
  LICENSE="AGREE"
  LICENSE_ACCEPT="AGREE"
  return 0
}

whiptail_airgap() {
  is_airgap=true
  INTERWEBS="AIRGAP"
  return 0
}

###############################################################################
# Host identity
###############################################################################

whiptail_set_hostname() {
  HOSTNAME="$HARD_HOSTNAME"
  return 0
}

whiptail_node_description() {
  NODE_DESCRIPTION="$HARD_DESCRIPTION"
  return 0
}

###############################################################################
# Networking (NO UI)
###############################################################################

whiptail_dhcp_or_static() {
  address_type="STATIC"
  export address_type
  return 0
}

whiptail_management_nic() {
  filter_unused_nics
  MNIC="${nic_list_management[0]}"

  if [[ -z "$MNIC" ]]; then
    MNIC="$(ls /sys/class/net | grep -v '^lo$' | head -n1)"
  fi

  export MNIC
  return 0
}

whiptail_management_interface_ip_mask() {
  MAINIP="$HARD_MGMT_CIDR"
  export MAINIP
  return 0
}

whiptail_management_interface_gateway() {
  MGATEWAY="$HARD_GATEWAY"
  export MGATEWAY
  return 0
}

whiptail_management_interface_dns() {
  MDNS="$HARD_DNS_SERVERS"
  export MDNS
  return 0
}

whiptail_management_interface_dns_search() {
  MSEARCH="$HARD_SEARCH_DOMAIN"
  export MSEARCH
  return 0
}

###############################################################################
# Docker
###############################################################################

whiptail_dockernet_check() { return 0; }

###############################################################################
# SOC Web
###############################################################################

whiptail_create_web_user() {
  WEBUSER="$HARD_WEBUSER"
  export WEBUSER
  return 0
}

whiptail_create_web_user_password1() {
  WEBPASSWD1="$HARD_WEBPASS"
  export WEBPASSWD1
  return 0
}

whiptail_create_web_user_password2() {
  WEBPASSWD2="$HARD_WEBPASS"
  export WEBPASSWD2
  return 0
}

whiptail_set_redirect() {
  REDIRECTINFO="IP"
  return 0
}

whiptail_so_allow_yesno() { return 0; }

whiptail_so_allow() {
  ALLOW_CIDR="$HARD_WEB_CIDR"
  export ALLOW_CIDR
  export ALLOW_ROLE="analyst"
  return 0
}

###############################################################################
# Confirmations / summaries (NO UI)
###############################################################################

whiptail_make_changes() { return 0; }

whiptail_end_settings() { return 0; }

whiptail_network_notice() { return 0; }

whiptail_net_reinit() { return 0; }

whiptail_ntp_ask() { return 1; }

whiptail_accept_telemetry() {
  telemetry=1
  return 0
}

###############################################################################
# End of file
###############################################################################